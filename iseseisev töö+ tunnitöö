# Küsime kasutajalt algandmed
N = int(input("Sisesta niidukite arv (N): "))
m = float(input("Sisesta esimese niiduki töötunnid (m): "))

kogu_aeg = 0            # Siia liidame kõigi niidukite tunnid kokku
niiduki_aeg = m         # Esimese niiduki aeg on m tundi
lisa_aeg = 10 / 60      # Teisendame 10 minutit tundideks (10 / 60 = 0.1667 tundi)

# Tsükkel käib läbi iga niiduki (kokku N korda)
for i in range(N):
    kogu_aeg += niiduki_aeg      # Lisame praeguse niiduki tööaja üldsummale
    niiduki_aeg += lisa_aeg      # Järgmine niiduk töötab 10 minutit (1/6 tundi) kauem

# Väljastame tulemuse (ümardame 2 komakohani, et oleks ilusam lugeda)
print(f"Kogu brigaad töötas kokku {kogu_aeg:.2f} tundi.")



kogus = 0   # Loendur, mis loeb kokku, mitu sobivat arvu leidsime
summa = 0   # Muutuja, kuhu liidame kõik leitud arvud kokku

# Vaatame läbi kõik arvud 100-st kuni 1000-ni (lõppväärtus on 1001, et 1000 jääks sisse)
for arv in range(100, 1001):
    
    # Kontrollime jäägiga jagamist (%). Kui jääk on 0, siis arv jagub 7-ga
    if arv % 7 == 0:
        print(arv, end=" ")   # Prindime arvu ekraanile (end=" " hoiab arvud ühel real)
        kogus += 1            # Suurendame leitud arvude loendurit ühe võrra
        summa += arv          # Liidame leitud arvu üldsummale juurde

# Prindime kokkuvõtte
print() # Teeb tühja rea vahele
print(f"7-ga jaguvaid arve on kokku: {kogus}")
print(f"Nende arvude summa on: {summa}")
