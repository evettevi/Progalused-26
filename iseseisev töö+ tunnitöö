
while True:
    print("\nVali ülesanne:")
    valik = input("Ülesanded 1–7, 0 – väljumiseks: ")

    if valik == "1":
        print("Valisid 1.")
        print("Sisestatakse 15 arvu. Määra, mitu neist on täisarvud.")

        for i in range(15):
            try:
                arv = float(input(f"Sisesta {i + 1}. arv: "))
                if arv.is_integer():
                    print(f"{arv:g} on täisarv.")
                else:
                    print(f"{arv:g} ei ole täisarv.")
            except ValueError:
                print("Vale sisend! Palun sisesta arv.")

    elif valik == "2":
        print("Valisid 2.")
        print("Leia kõigi naturaalarvude summa vahemikus 1 kuni A.")

        while True:
            try:
                A = int(input("Sisesta naturaalarv A: "))
                if A < 1:
                    print("Vale sisend! Palun sisesta naturaalarv (A >= 1).")
                else:
                    break
            except ValueError:
                print("Vale sisend! Palun sisesta täisarv.")

        summa = sum(range(1, A + 1))
        print(
            f"Kõigi naturaalarvude summa vahemikus "
            f"1 kuni {A} on: {summa}"
        )

    elif valik == "3":
        print("Valisid 3.")
        print("Sisestage 8 arvu. Leida positiivsete arvude korrutis.")

        korrutis = 1
        positiivseid = 0

        for i in range(8):
            try:
                arv = float(input(f"Sisesta {i + 1}. arv: "))
                if arv > 0:
                    korrutis *= arv
                    positiivseid += 1
                else:
                    print(f"{arv:g} ei ole positiivne arv.")
            except ValueError:
                print("Vale sisend! Palun sisesta arv.")

        if positiivseid == 0:
            print("Positiivseid arve ei sisestatud.")
        else:
            print(f"Positiivsete arvude korrutis on: {korrutis:g}")

    elif valik == "4":
        print("Valisid 4.")
        print("Arvude ruudud vahemikus 10 kuni 20:")

        for i in range(10, 21):
            print(f"{i} ruut on: {i ** 2}")

    elif valik == "5":
        print("Valisid 5.")
        print("Arvuta negatiivsete arvude summa.")

        while True:
            try:
                N = int(input("Sisesta täisarv N: "))
                if N < 0:
                    print("Arvude arv ei saa olla negatiivne.")
                else:
                    break
            except ValueError:
                print("Vale sisend! Palun sisesta täisarv.")

        summa = 0

        for i in range(N):
            try:
                arv = float(input(f"Sisesta {i + 1}. arv: "))
                if arv < 0:
                    summa += arv
            except ValueError:
                print("Vale sisend! Palun sisesta arv.")

        print(f"Negatiivsete arvude summa on: {summa:g}")

    elif valik == "6":
        print("Valisid 6.")
        print("""
Klaviatuurilt sisestatakse N arvu.
Leida, mitu arvu on negatiivsed, mitu positiivsed
ning mitu neist võrdub nulliga.
""")

        while True:
            try:
                N = int(input("Sisesta täisarv N: "))
                if N < 0:
                    print("Arvude arv ei saa olla negatiivne.")
                else:
                    break
            except ValueError:
                print("Vale sisend! Palun sisesta täisarv.")

        negatiivsed = 0
        positiivsed = 0
        nullid = 0

        for i in range(N):
            try:
                arv = float(input(f"Sisesta {i + 1}. arv: "))
                if arv < 0:
                    negatiivsed += 1
                elif arv > 0:
                    positiivsed += 1
                else:
                    nullid += 1
            except ValueError:
                print("Vale sisend! Palun sisesta arv.")

        print(f"Negatiivsete arvude arv: {negatiivsed}")
        print(f"Positiivsete arvude arv: {positiivsed}")
        print(f"Nullide arv: {nullid}")

    elif valik == "7":
        print("Valisid 7.")
        print("Kuva arvud vahemikus [A, B], mis jaguvad K-ga.")

        while True:
            try:
                A = int(input("Sisesta täisarv A: "))
                B = int(input("Sisesta täisarv B: "))
                K = int(input("Sisesta täisarv K: "))

                if A > B:
                    print("Vale sisend! A peab olema väiksem või võrdne B-ga.")
                    continue

                if K == 0:
                    print("Vale sisend! K ei tohi olla 0.")
                    continue

                break
            except ValueError:
                print("Vale sisend! Palun sisesta täisarvud.")

        leitud = False

        for i in range(A, B + 1):
            if i % K == 0:
                print(f"{i} on {K}-ga jaguv.")
                leitud = True

        if not leitud:
            print(f"Vahemikus {A} kuni {B} puuduvad arvud, mis jaguvad {K}-ga.")

    elif valik == "0":
        print("Väljumine...")
        break

    else:
        print("Vale valik!")

